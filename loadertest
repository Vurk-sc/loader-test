-- Payload Loader
local function ExecuteMainScript()
    StatusLabel.TextColor3 = Color3.fromRGB(100, 210, 140)
    StatusLabel.Text = "Key verified"
    
    TweenService:Create(AccentLine, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(100, 210, 140)}):Play()
    TweenService:Create(SubmitBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(100, 210, 140), TextColor3 = Color3.fromRGB(14, 14, 16)}):Play()
    SubmitBtn.Text = "Authenticated"
    
    task.wait(0.8)
    
    -- Smooth Scale Out
    local CloseTween = TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 320, 0, 0),
        Position = UDim2.new(0.5, -160, 0.5, 0),
        BackgroundTransparency = 1
    })
    
    TweenService:Create(MainBorder, TweenInfo.new(0.2), {Transparency = 1}):Play()
    CloseTween:Play()
    CloseTween.Completed:Wait()
    
    ScreenGui:Destroy()

    ------------------------------------------------------------------
    -- YOUR MAIN SCRIPT GOES HERE
    ------------------------------------------------------------------
    print("Loader finished. Running payload...")
    ------------------------------------------------------------------
end

-- Key Validation Logic
local isProcessing = false

local function ValidateKey()
    if isProcessing then return end
    isProcessing = true
    
    local CleanKey = string.gsub(KeyInput.Text, "^%s*(.-)%s*$", "%1")
    
    if CleanKey == VALID_KEY then
        ExecuteMainScript()
    else
        StatusLabel.TextColor3 = Color3.fromRGB(235, 85, 85)
        StatusLabel.Text = "Invalid key code"
        
        -- Subtle horizontal nudge
        local BasePos = UDim2.new(0.5, -160, 0.5, -105)
        TweenService:Create(MainFrame, TweenInfo.new(0.05), {Position = BasePos + UDim2.new(0, -4, 0, 0)}):Play()
        task.wait(0.05)
        TweenService:Create(MainFrame, TweenInfo.new(0.05), {Position = BasePos + UDim2.new(0, 4, 0, 0)}):Play()
        task.wait(0.05)
        TweenService:Create(MainFrame, TweenInfo.new(0.05), {Position = BasePos}):Play()
        
        isProcessing = false
    end
end

-- Connections
SubmitBtn.MouseButton1Click:Connect(ValidateKey)
KeyInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        ValidateKey()
    end
end)
